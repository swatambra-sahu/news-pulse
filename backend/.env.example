# Port the Express server listens on
PORT=4000

# Path to the shared SQLite DB file written by the Python scraper.
# Defaults to <repo>/data/newspulse.sqlite3 if unset.
DB_PATH=../data/newspulse.sqlite3

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:3000

# Command used to invoke the Python scraper pipeline as a subprocess.
# On most systems this is "python3"; on deployment hosts it may need to
# point at a venv, e.g. /opt/venv/bin/python
PYTHON_BIN=python3

# Absolute or relative path to the scraper's main.py entry point.
SCRAPER_PATH=../scraper/main.py
